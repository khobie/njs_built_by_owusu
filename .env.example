# Copy this file to ".env" in the same folder (name must be exactly .env).

# --- Option A: PostgreSQL via Docker (recommended on Windows) ---
# 1. Run:  docker compose up -d
# 2. Use this URL as-is (matches docker-compose.yml):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/njs_form_system?schema=public"

# --- Option B: Your own PostgreSQL / cloud ---
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# --- Vercel production ---
# 1. Set DATABASE_URL in Vercel (Neon/Supabase/Railway — use the *pooled* connection string if offered).
# 2. Set NEXTAUTH_SECRET to a long random string (same on all environments you deploy).
# 3. After first deploy, run once locally against production URL:
#      npx prisma db push
#      npm run db:seed
#    Or on Vercel: use "Load electorals from delegate DB" under EA Portal → Areas while logged in as admin.
